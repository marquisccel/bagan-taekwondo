{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/drizzle.config.ts",
    "tools/*/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "vitest.config.ts"
  ]
}
