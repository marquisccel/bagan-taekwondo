# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgres://bagantkd:bagantkd_dev_only@127.0.0.1:5433/bagantkd

# Application-level encryption key for NIK (AES-256-GCM, 32 bytes base64). Phase 2.
NIK_ENCRYPTION_KEY=
# HMAC key for the NIK blind index (32 bytes base64). Phase 2.
NIK_BLIND_INDEX_KEY=

# Path to the private 2026 registration CSV used by golden tests (see data/README.md).
GOLDEN_DATASET_PATH=data/private/DATA_KOLEKTIF_FESTIVAL_PRESTASI - query_kolektif.csv
