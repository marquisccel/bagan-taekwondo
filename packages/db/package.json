{
  "name": "@bagantkd/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing/seed": {
      "source": "./src/testing/seed.ts",
      "types": "./dist/testing/seed.d.ts",
      "default": "./dist/testing/seed.js"
    },
    "./testing/seed-revision": {
      "source": "./src/testing/seed-revision.ts",
      "types": "./dist/testing/seed-revision.d.ts",
      "default": "./dist/testing/seed-revision.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "generate": "node --conditions=source ./node_modules/drizzle-kit/bin.cjs generate",
    "migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "@bagantkd/domain": "workspace:*",
    "@bagantkd/draw-engine": "workspace:*",
    "@bagantkd/export": "workspace:*",
    "@bagantkd/intake": "workspace:*",
    "@bagantkd/rules": "workspace:*",
    "@bagantkd/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10"
  }
}
